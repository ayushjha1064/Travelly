# macOS AirPlay commonly occupies port 5000.
PORT=5001
BASE_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local example; use your actual PostgreSQL connection string.
DATABASE_URL=postgresql://travelly_local@127.0.0.1:55432/travelly_dev

# Health endpoint starts without Firebase. Protected APIs need all three values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Backend only. Get a key from Google AI Studio. Never put this in Flutter's .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional existing route-planning integrations.
ORS_API_KEY=
SERPAPI_KEY=

# Local uploads default to backend/uploads when LOCAL_UPLOAD_ROOT is blank.
MEDIA_STORAGE_DRIVER=local
LOCAL_UPLOAD_ROOT=
# Retain the existing deployment key for existing encrypted media.
ENCRYPTION_KEY=

# Needed only with the remote media driver (see README).
IITK_SFTP_HOST=
IITK_SFTP_PORT=22
IITK_SFTP_USER=
IITK_SFTP_PASSWORD=
IITK_UPLOAD_ROOT=
IITK_PUBLIC_BASE_URL=

# JWT_SECRET and JWT_EXPIRE are unused: authentication uses Firebase ID tokens.
